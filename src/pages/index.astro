---
import SpeedTest from "../speed-test/components/SpeedTest";
import Layout from "../layouts/Layout.astro";
import FAQ from "../speed-test/components/FAQ.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<Layout showMeshGradient={true}>
  {/* Main Speed Test Island */}
  <main class="flex-1 flex flex-col justify-center">
    <SpeedTest client:only="react" />
  </main>

  {/* About the Tool */}
  <section
    id="seo-content-section"
    class="border-t border-hairline bg-canvas-soft-2 py-16 relative overflow-hidden"
  >
    <div class="max-w-4xl mx-auto px-4 md:px-8">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-3">
          <span
            class="font-mono text-xs uppercase tracking-wider text-mute block"
          >
            How it works
          </span>
          <h2
            class="text-2xl md:text-3xl font-semibold tracking-tight text-ink font-sans"
          >
            What this tool measures and why it matters.
          </h2>
          <p class="text-sm md:text-base text-body leading-relaxed max-w-3xl">
            This tool measures four key properties of your internet connection:
            download speed, upload speed, latency, and jitter. Each one tells
            you something different about how your connection performs in the
            real world. Download speed determines how quickly you can pull data
            from the internet — streaming video, loading web pages, downloading
            files. Upload speed determines how fast you can send data — video
            calls, posting content, backing up files. Latency measures the delay
            between your device and the server, which affects how responsive
            everything feels. Jitter measures how stable that delay is over
            time.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-hairline pt-8"
        >
          <div class="flex flex-col gap-4">
            <h3 class="text-lg font-semibold tracking-tight text-ink font-sans">
              Why test your connection?
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Most people only think about their internet speed when something
              feels broken — a video call keeps freezing, a game feels laggy, or
              a webpage takes forever to load. Running a speed test gives you
              concrete numbers instead of guesswork. If your download speed is
              well below what your ISP promised, you have evidence to show them.
              If your latency spikes when someone else in the house starts a
              large download, you know the problem is bufferbloat, not your
              plan.
            </p>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Regular testing also helps you track changes over time. A
              connection that worked fine six months ago might be degrading due
              to aging equipment, increased neighborhood congestion, or ISP
              routing changes. Comparing results from different times of day and
              different days of the week gives you a clearer picture of your
              typical experience.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="text-lg font-semibold tracking-tight text-ink font-sans">
              How it works under the hood
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              Unlike traditional speed tests that download static files from a
              single server, this engine uses Cloudflare's edge network to serve
              randomly generated binary payloads. The data cannot be cached by
              your ISP or compressed by intermediate networks, so the test
              reflects your actual connection capacity rather than a cached
              local copy.
            </p>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              The download test opens six parallel streams through Web Workers,
              each pulling data simultaneously to stress your connection. The
              upload test does the same in reverse. Throughout both phases, the
              engine measures loaded latency — your ping while the network is
              under heavy load — which reveals bufferbloat that idle ping tests
              miss entirely. The final quality score weighs all of these metrics
              together to reflect how the connection actually feels, not just
              how fast it is on paper.
            </p>
          </div>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-hairline pt-8"
        >
          <div class="flex flex-col gap-4">
            <h3 class="text-lg font-semibold tracking-tight text-ink font-sans">
              Tips for accurate results
            </h3>
            <ul
              class="list-decimal pl-5 text-xs md:text-sm text-body flex flex-col gap-1"
            >
              <li>
                <strong>Disconnect VPNs.</strong> Virtual private networks route your
                traffic through extra servers, adding latency and reducing throughput.
              </li>
              <li>
                <strong>Close background apps.</strong> Cloud backups, streaming on
                other devices, and system updates consume bandwidth and skew your
                results.
              </li>
              <li>
                <strong>Use Ethernet for baseline.</strong> WiFi introduces variability
                from interference and distance. A wired connection gives you the truest
                picture of your ISP's delivery.
              </li>
              <li>
                <strong>Test at different times.</strong> Network congestion changes
                throughout the day. Testing in the morning and evening on different
                days shows you the range of your real experience.
              </li>
            </ul>
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="text-lg font-semibold tracking-tight text-ink font-sans">
              Understanding your results
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              A download speed of 25 Mbps is enough for a single 4K stream. A
              household with multiple people streaming and video calling at the
              same time needs considerably more. For video calls, latency under
              50 ms and jitter under 10 ms matter more than raw speed — a fast
              connection with high latency will still feel choppy on a call. For
              gaming, latency under 30 ms gives you a noticeable edge. For
              general browsing, a balanced connection with reasonable numbers
              across all metrics provides the smoothest experience.
            </p>
            <p class="text-xs md:text-sm text-body leading-relaxed">
              If your results consistently fall short of what you need, the
              problem could be your equipment, your WiFi setup, or your internet
              plan. Check out our{" "}
              <a href="/blog" class="text-link hover:underline">blog</a> for detailed
              guides on diagnosing and fixing common connection issues.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Featured Blog Articles */}
  <section
    class="border-t border-hairline bg-canvas py-16 relative overflow-hidden"
  >
    <div class="max-w-4xl mx-auto px-4 md:px-8">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <span
            class="font-mono text-xs uppercase tracking-wider text-mute block"
          >
            From the blog
          </span>
          <div class="flex items-center justify-between gap-4">
            <h2
              class="text-2xl md:text-3xl font-semibold tracking-tight text-ink font-sans"
            >
              Latest articles.
            </h2>
            <a
              href="/blog"
              class="font-mono text-xs text-link hover:text-link-deep transition-colors duration-150 inline-flex items-center gap-1.5 shrink-0"
            >
              View all
              <svg
                class="w-3 h-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col gap-3 p-5 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong hover:bg-canvas-soft transition-[border-color,background-color] duration-150"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-[10px] uppercase tracking-wider text-mute"
                >
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <h3 class="text-base font-semibold tracking-tight text-ink font-sans group-hover:text-link transition-colors duration-150 leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-xs text-body leading-relaxed line-clamp-2">
                  {post.data.description}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* Interactive FAQ Section */}
  <FAQ />
</Layout>
