---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { FAQ_ITEMS } from "../speed-test/constants";

const faqs = FAQ_ITEMS;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Frequently Asked Questions — NetSpeed"
  description="Answers to common questions about internet speed, network metrics, speed testing, and how to diagnose connection problems."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <main class="flex-1 py-16 px-4 md:px-8">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      {/* Header */}
      <div class="flex flex-col gap-3 border-b border-hairline pb-6">
        <span
          class="font-mono text-xs uppercase tracking-wider text-mute block"
        >
          FAQ
        </span>
        <h1
          class="text-3xl md:text-5xl font-semibold tracking-tight text-ink font-sans"
        >
          Frequently asked questions.
        </h1>
        <p class="text-sm md:text-base text-body mt-1 leading-relaxed">
          Find answers to frequently asked questions about network metrics, internet speed
          testing, latency telemetry, and how to optimize your connection.
        </p>
      </div>

      {/* FAQ List */}
      <div
        class="flex flex-col border-t border-hairline divide-y divide-hairline"
      >
        {
          faqs.map((faq) => (
            <details class="group py-4 select-none">
              <summary class="flex justify-between items-center cursor-pointer list-none text-sm md:text-base font-semibold text-ink hover:text-link transition-colors duration-150 py-1">
                <span>{faq.question}</span>
                <span class="ml-4 flex items-center justify-center w-5 h-5 rounded-full border border-hairline group-hover:border-hairline-strong transition-colors duration-150 shrink-0">
                  <svg
                    class="w-3 h-3 text-mute group-open:rotate-180 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </span>
              </summary>
              <div class="faq-answer mt-3 text-xs md:text-sm text-body leading-relaxed max-w-3xl pb-2 pl-1">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>

      {/* CTA */}
      <section class="border-t border-hairline pt-12">
        <div
          class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 bg-canvas-soft-2 p-8 rounded-lg border border-hairline"
        >
          <div class="flex flex-col gap-2 max-w-xl">
            <h3 class="text-lg font-semibold tracking-tight text-ink">
              Still have questions?
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Run a speed test to see your connection metrics, or check out our
              blog for detailed guides on diagnosing and fixing network issues.
            </p>
          </div>
          <div class="flex gap-3">
            <a
              href="/"
              class="bg-primary text-on-primary font-medium text-xs rounded-full py-2 px-6 hover:opacity-90 active:scale-95 transition-[opacity,transform] text-center select-none cursor-pointer inline-block whitespace-nowrap shadow-xs"
            >
              Run Speed Test
            </a>
            <a
              href="/blog"
              class="bg-canvas text-ink border border-hairline hover:border-hairline-strong font-medium text-xs rounded-full py-2 px-6 transition-[border-color] text-center select-none cursor-pointer inline-block whitespace-nowrap"
            >
              Read Blog
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
