---
// Google Analytics non-blocking interaction loader and AdSense
---

<!-- Google Analytics - non-blocking idle and interaction loader -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () {
    window.dataLayer.push(arguments);
  };
  gtag("js", new Date());
  gtag("config", "G-341P014VS4");

  (function () {
    var loaded = false;
    function loadGA() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=G-341P014VS4";
      document.head.appendChild(s);
      ["pointerdown", "scroll", "keydown"].forEach(function (e) {
        window.removeEventListener(e, loadGA, { passive: true });
      });
    }

    ["pointerdown", "scroll", "keydown"].forEach(function (e) {
      window.addEventListener(e, loadGA, { once: true, passive: true });
    });

    function onIdle() {
      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadGA, { timeout: 2500 });
      } else {
        setTimeout(loadGA, 2000);
      }
    }

    if (document.readyState === "complete") {
      onIdle();
    } else {
      window.addEventListener("load", onIdle, { once: true });
    }
  })();
</script>

<!-- Google AdSense -->
<script
  is:inline
  async
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5638352527724874"
  crossorigin="anonymous"
></script>
