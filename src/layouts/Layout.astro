---
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
  showMeshGradient?: boolean;
}
const {
  title = "Free Internet Speed Test — Accurate Broadband & Latency Check | NetSpeed",
  description = "Test your internet download, upload, ping latency, jitter, and bufferbloat with uncompressed payloads and global edge routing. Accurate, fast, and transparent network diagnostics.",
  showMeshGradient = false,
} = Astro.props;

const isProd = import.meta.env.PROD;

const siteOrigin = Astro.site?.origin || "https://freenetspeed.com";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL("/og-image.png", siteOrigin).href;

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "NetSpeed",
      "url": siteOrigin,
      "description": "High-precision network speed test and latency diagnostic tool.",
    },
    {
      "@type": "WebApplication",
      "name": "NetSpeed Internet Speed Test",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(siteSchema)}
    />

    <!-- Preload Primary Font for immediate render without layout shift -->
    <link
      rel="preload"
      href="/fonts/Inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Google Analytics — deferred until page load + browser idle -->
    <script is:inline>
      (function () {
        var loaded = false;
        function loadGA() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-341P014VS4";
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", "G-341P014VS4");
        }
        function onIdle() {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(loadGA, { timeout: 30000 });
          } else {
            setTimeout(loadGA, 30000);
          }
        }
        if (document.readyState === "complete") {
          onIdle();
        } else {
          window.addEventListener("load", onIdle);
        }
      })();
    </script>

    <!-- Google AdSense — production only, deferred until browser idle to eliminate CLS and network contention -->
    {
      isProd && (
        <script is:inline>
          (function () {
            var adsLoaded = false;
            function loadAdSense() {
              if (adsLoaded) return;
              adsLoaded = true;
              var s = document.createElement("script");
              s.async = true;
              s.crossOrigin = "anonymous";
              s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5638352527724874";
              document.head.appendChild(s);
            }
            function onIdle() {
              if ("requestIdleCallback" in window) {
                requestIdleCallback(loadAdSense, { timeout: 4000 });
              } else {
                setTimeout(loadAdSense, 2000);
              }
            }
            if (document.readyState === "complete") {
              onIdle();
            } else {
              window.addEventListener("load", onIdle);
            }
          })();
        </script>
      )
    }

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <!-- Fonts are self-hosted via @font-face in global.css -->

    <!-- Inline theme initialization via localStorage — synchronous, no FOUC -->
    <script is:inline>
      (function () {
        var savedTheme = localStorage.getItem("theme");
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body
    class="bg-canvas-soft text-ink font-sans antialiased min-h-screen relative"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-primary focus:text-on-primary focus:px-3 focus:py-1.5 focus:rounded focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>
    <!-- Mesh gradient overlay — homepage only for GPU savings -->
    {
      showMeshGradient && (
        <div class="mesh-gradient-container">
          <div class="mesh-gradient" />
        </div>
      )
    }
    <div class="relative z-10 flex flex-col min-h-screen">
      <Header />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Theme toggle setup on page load
      const setupThemeToggle = () => {
        const themeToggle = document.getElementById("header-theme-toggle");
        if (themeToggle) {
          themeToggle.addEventListener("click", () => {
            const wasDark = document.documentElement.classList.contains("dark");
            const nextDark = !wasDark;

            if (nextDark) {
              document.documentElement.classList.add("dark");
            } else {
              document.documentElement.classList.remove("dark");
            }

            // Persist in localStorage - enables synchronous FOUC prevention
            const themeValue = nextDark ? "dark" : "light";
            localStorage.setItem("theme", themeValue);

            // Broadcast change event to React
            window.dispatchEvent(
              new CustomEvent("theme-changed", {
                detail: { theme: themeValue },
              }),
            );
          });
        }
      };

      setupThemeToggle();
      document.addEventListener("astro:after-swap", setupThemeToggle);

      const setupTerminalToggle = () => {
        const terminalToggle = document.getElementById(
          "header-terminal-toggle",
        );
        if (terminalToggle) {
          // Seed localStorage on first visit so script and React agree on the default
          if (localStorage.getItem("terminal-open") === null) {
            localStorage.setItem("terminal-open", "false");
          }

          const isOpen = localStorage.getItem("terminal-open") === "true";
          terminalToggle.classList.toggle("bg-canvas-soft-2", isOpen);
          terminalToggle.classList.toggle("text-ink", isOpen);
          terminalToggle.classList.toggle("border-primary", isOpen);
          terminalToggle.classList.toggle("text-primary", isOpen);

          terminalToggle.addEventListener("click", () => {
            const currentlyOpen =
              localStorage.getItem("terminal-open") === "true";
            const nextOpen = !currentlyOpen;
            localStorage.setItem("terminal-open", String(nextOpen));

            // Update button visual state
            terminalToggle.classList.toggle("bg-canvas-soft-2", nextOpen);
            terminalToggle.classList.toggle("text-ink", nextOpen);
            terminalToggle.classList.toggle("border-primary", nextOpen);
            terminalToggle.classList.toggle("text-primary", nextOpen);

            window.dispatchEvent(
              new CustomEvent("toggle-terminal", {
                detail: { open: nextOpen },
              }),
            );
          });
        }
      };

      setupTerminalToggle();
      document.addEventListener("astro:after-swap", setupTerminalToggle);
    </script>
  </body>
</html>
