---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  author?: string;
  tags?: string[];
}

const {
  title = "Blog Article",
  description = "",
  pubDate = new Date(),
  updatedDate,
  author = "NetSpeed",
  tags = [],
} = Astro.props;

const safePubDate = pubDate instanceof Date && !isNaN(pubDate.getTime())
  ? pubDate
  : typeof pubDate === "string" && !isNaN(new Date(pubDate).getTime())
    ? new Date(pubDate)
    : new Date();

const safeUpdatedDate = updatedDate instanceof Date && !isNaN(updatedDate.getTime())
  ? updatedDate
  : typeof updatedDate === "string" && !isNaN(new Date(updatedDate).getTime())
    ? new Date(updatedDate)
    : null;

const formattedPubDate = safePubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdatedDate = safeUpdatedDate
  ? safeUpdatedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    name: author,
    url: "https://apurba-dev.netlify.app/",
    jobTitle: "Network Telemetry Engineer & Founder",
  },
  publisher: {
    "@type": "Organization",
    name: "NetSpeed",
    url: "https://freenetspeed.com",
    logo: {
      "@type": "ImageObject",
      url: "https://freenetspeed.com/favicon.svg",
    },
  },
  datePublished: safePubDate.toISOString(),
  dateModified: safeUpdatedDate
    ? safeUpdatedDate.toISOString()
    : safePubDate.toISOString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": Astro.url.href,
  },
};
---

<Layout title={`${title} — NetSpeed Blog`} description={description}>
  <main class="flex-1 py-16 px-4 md:px-8">
    <article class="max-w-3xl mx-auto flex flex-col gap-10">
      {/* Article Header */}
      <header class="flex flex-col gap-4 border-b border-hairline pb-8">
        <a
          href="/blog"
          class="font-mono text-xs uppercase tracking-wider text-link hover:text-link-deep transition-colors duration-150 inline-flex items-center gap-1.5"
        >
          <svg
            class="w-3 h-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
          Back to Blog
        </a>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="font-mono text-[10px] uppercase tracking-wider text-mute bg-canvas-soft-2 px-2.5 py-1 rounded-full border border-hairline">
                {tag}
              </span>
            ))}
          </div>
        )}

        <h1
          class="text-3xl md:text-5xl font-semibold tracking-tight text-ink font-sans leading-tight"
        >
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-mute">
          <span class="text-ink font-medium">Written by {author}</span>
          <span class="text-hairline-strong">·</span>
          <time datetime={safePubDate.toISOString()}>{formattedPubDate}</time>
          {formattedUpdatedDate && (
            <>
              <span class="text-hairline-strong">·</span>
              <span>Updated {formattedUpdatedDate}</span>
            </>
          )}
          <span class="text-hairline-strong">·</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-sans text-[11px] font-medium inline-flex items-center gap-1">
            <svg class="w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Technical Review Verified
          </span>
        </div>

        <p class="text-base md:text-lg text-body leading-relaxed max-w-3xl mt-1">
          {description}
        </p>
      </header>

      {/* Article Content */}
      <div
        class="prose flex flex-col gap-6 text-sm md:text-base text-body leading-relaxed"
      >
        <slot />
      </div>

      {/* Author Bio Card for E-EAT Credibility */}
      <section class="border-t border-hairline pt-8">
        <div class="bg-canvas-soft-2 p-6 md:p-7 rounded-lg border border-hairline flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <div class="w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-lg shrink-0 shadow-xs">
            AG
          </div>
          <div class="flex flex-col gap-1.5 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h3 class="text-sm md:text-base font-semibold text-ink">
                  {author}
                </h3>
                <p class="text-xs text-mute font-mono">
                  Network Systems Engineer &amp; Founder of NetSpeed
                </p>
              </div>
              <a
                href="https://apurba-dev.netlify.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-link hover:text-link-deep transition-colors inline-flex items-center gap-1"
              >
                Portfolio &amp; Research &rarr;
              </a>
            </div>
            <p class="text-xs text-body leading-relaxed mt-1">
              Specializing in low-latency distributed network benchmarks, edge socket routing, and bufferbloat mitigation. Published diagnostic telemetry guides to help broadband users verify real connection performance.
            </p>
          </div>
        </div>
      </section>

      {/* Article Footer CTA */}
      <footer class="border-t border-hairline pt-8">
        <div
          class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 bg-canvas-soft-2 p-8 rounded-lg border border-hairline"
        >
          <div class="flex flex-col gap-2 max-w-xl">
            <h3 class="text-lg font-semibold tracking-tight text-ink">
              Ready to test your connection?
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Put what you learned into practice. Run a detailed speed test to
              measure your download, upload, latency, and jitter.
            </p>
          </div>
          <a
            href="/"
            class="bg-primary text-on-primary font-medium text-xs rounded-full py-2 px-6 hover:opacity-90 active:scale-95 transition-[opacity,transform] text-center select-none cursor-pointer inline-block whitespace-nowrap shadow-xs"
          >
            Run Speed Test
          </a>
        </div>
      </footer>
    </article>
  </main>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
</Layout>

<style>
  /* Prose styling for blog content */
  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .prose :global(p) {
    margin-bottom: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .prose :global(li) {
    line-height: 1.7;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .prose :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .prose :global(a:hover) {
    color: var(--color-link-deep);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-canvas-soft-2);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    border: 1px solid var(--color-hairline);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-hairline-strong);
    padding-left: 1rem;
    color: var(--color-body);
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-hairline);
    margin: 1.5rem 0;
  }
</style>
