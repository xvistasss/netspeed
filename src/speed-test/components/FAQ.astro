---
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is a good internet speed?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A good internet speed depends on what you do online. For general browsing, 25 Mbps is enough. For HD streaming, you need about 15 Mbps. For 4K streaming, aim for 25 Mbps per stream. A household with multiple people should aim for 100-300 Mbps to ensure everyone has enough bandwidth.",
      },
    },
    {
      "@type": "Question",
      name: "Why is my internet speed so slow?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Slow speeds can come from many sources: WiFi interference and distance from the router, background applications consuming bandwidth, outdated equipment, or network congestion during peak hours. Try restarting your router, connecting via Ethernet, and closing background apps to diagnose the issue.",
      },
    },
    {
      "@type": "Question",
      name: "Why doesn't my speed test match the plan I pay for?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "ISPs advertise speeds as 'up to' a number measured under ideal conditions. Real-world speeds are lower due to protocol overhead, WiFi limitations, your router's capabilities, and network congestion. Test on Ethernet to see what your ISP actually delivers to your home.",
      },
    },
    {
      "@type": "Question",
      name: "What is bufferbloat?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Bufferbloat is a condition where latency spikes dramatically under network load due to oversized buffers in your router or ISP equipment. Your ping might be 15 ms when idle but jump to 300 ms during a download. Enabling Smart Queue Management (SQM) on your router is the most effective fix.",
      },
    },
  ],
};

const mainEntity = faqJsonLd.mainEntity;
---

<!-- JSON-LD Structured Schema for FAQ Page SEO -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(faqJsonLd)}
/>

<section
  id="faq-section"
  class="border-t border-hairline bg-canvas py-16 relative overflow-hidden"
>
  <div class="max-w-4xl mx-auto px-4 md:px-8">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-2">
        <span
          class="font-mono text-xs uppercase tracking-wider text-mute block"
          id="faq-eyebrow"
        >
          Frequently Asked Questions
        </span>
        <div class="flex items-center justify-between gap-4">
          <h2
            class="text-2xl md:text-3xl font-semibold tracking-tight text-ink font-sans"
            id="faq-heading"
          >
            Frequently asked questions.
          </h2>
          <a
            href="/faq"
            class="font-mono text-xs text-link hover:text-link-deep transition-colors duration-150 inline-flex items-center gap-1.5 shrink-0"
          >
            View all
            <svg
              class="w-3 h-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14"></path>
              <path d="M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        <p class="text-sm md:text-base text-body leading-relaxed max-w-2xl">
          Find answers to common questions about network metrics, speed
          diagnostic performance, and how to optimize your internet connection.
        </p>
      </div>

      {/* Accordion List */}
      <div
        class="flex flex-col border-t border-hairline divide-y divide-hairline"
      >
        {
          mainEntity.map((item) => (
            <details class="group py-4 select-none">
              <summary class="flex justify-between items-center cursor-pointer list-none text-sm md:text-base font-semibold text-ink hover:text-link transition-colors duration-150 py-1">
                <span>{item.name}</span>
                <span class="ml-4 flex items-center justify-center w-5 h-5 rounded-full border border-hairline group-hover:border-hairline-strong transition-colors duration-150">
                  <svg
                    class="w-3 h-3 text-mute group-open:rotate-180 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </span>
              </summary>
              <div class="faq-answer mt-3 text-xs md:text-sm text-body leading-relaxed max-w-3xl pb-2 pl-1">
                {item.acceptedAnswer.text}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Reset standard details arrow across all browsers */
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    list-style: none;
  }

  /* Apply premium micro-animation to answer visibility */
  details[open] .faq-answer {
    animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
